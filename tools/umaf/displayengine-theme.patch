+/**
+  Clear Screen to the initial state.
+**/
+VOID
+EFIAPI
+DriverClearDisplayPage (
+  VOID
+  )
+{
+  ThemeConsoleActivate ();
+  ClearDisplayPage ();
+  mIsFirstForm = TRUE;
+}
+
+/**
+  Mr. Machine: "save before leaving?" that lists the changed settings.
+**/
+UINTN
+EFIAPI
+ThemeConfirmDataChange (
+  VOID
+  )
+{
+  EFI_INPUT_KEY  Key;
+
+  ThemeConsoleActivate ();
+  if (ThemeChangeCount () == 0) {
+    return ConfirmDataChange ();
+  }
+
+  gST->ConIn->ReadKeyStroke (gST->ConIn, &Key);
+  do {
+    ThemeConfirmWithChanges (L"Save these changes before leaving?", L"Y = save    N = discard    Esc = stay here", &Key);
+  } while ((Key.ScanCode != SCAN_ESC) &&
+           ((Key.UnicodeChar | UPPER_LOWER_CASE_OFFSET) != (L'y' | UPPER_LOWER_CASE_OFFSET)) &&
+           ((Key.UnicodeChar | UPPER_LOWER_CASE_OFFSET) != (L'n' | UPPER_LOWER_CASE_OFFSET)));
+
+  if (Key.ScanCode == SCAN_ESC) {
+    return BROWSER_ACTION_NONE;
+  }
+
+  ThemeClearChanges ();
+  if ((Key.UnicodeChar | UPPER_LOWER_CASE_OFFSET) == (L'y' | UPPER_LOWER_CASE_OFFSET)) {
+    return BROWSER_ACTION_SUBMIT;
+  }
+
+  return BROWSER_ACTION_DISCARD;
+}
+
+/**
+  Set Buffer to Value for Size bytes.
+
+  @param  Buffer                 Memory to set.
+  @param  Size                   Number of bytes to set
+  @param  Value                  Value of the set operation.
+
+**/
+VOID
+SetUnicodeMem (
+  IN VOID    *Buffer,
+  IN UINTN   Size,
+  IN CHAR16  Value
+  )
+{
+  CHAR16  *Ptr;
+
+  Ptr = Buffer;
+  while ((Size--)  != 0) {
+    *(Ptr++) = Value;
+  }
+}
