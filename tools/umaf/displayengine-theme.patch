+  if (Prompt == NULL) {
+    return FALSE;
+  }
+
+  for (I = 0; I < ARRAY_SIZE (mNoSave); I++) {
+    if (CompareNoCase (Prompt, mNoSave[I]) == 0) {
+      return TRUE;
+    }
+  }
+
+  return FALSE;
+}
+
+STATIC
+CONST CHAR16 *
+LookupDesc (
+  IN CONST CHAR16  *Prompt
+  )
+{
+  UINTN  I;
+
+  if (Prompt == NULL) {
+    return NULL;
+  }
+
+  for (I = 0; I < ARRAY_SIZE (mDesc); I++) {
+    if (CompareNoCase (Prompt, mDesc[I].Prompt) == 0) {
+      return mDesc[I].Text;
+    }
+  }
+
+  return NULL;
+}
+
+STATIC
+CONST CHAR16 *
+GenericDesc (
+  IN UINT8  OpCode
+  )
+{
+  switch (OpCode) {
+    case EFI_IFR_ONE_OF_OP:
+      return L"Press Enter to pick a value from the list, or +/- to step through them.";
+    case EFI_IFR_NUMERIC_OP:
+      return L"Type a number and press Enter, or use +/- to change it.";
+    case EFI_IFR_CHECKBOX_OP:
+      return L"Press Enter or Space to switch it on or off.";
+    case EFI_IFR_REF_OP:
+      return L"Opens a sub-menu. Press Enter to go in, Esc to come back.";
+    case EFI_IFR_ACTION_OP:
+      return L"Runs an action when you press Enter.";
+    case EFI_IFR_STRING_OP:
+    case EFI_IFR_PASSWORD_OP:
+      return L"Press Enter to type a new value.";
+    default:
+      return NULL;
+  }
+}
+
+//
+// Text for a question value ("Manual", "60", "Enabled"). Caller frees.
+//
+STATIC
+CHAR16 *
+ValueText (
+  IN FORM_DISPLAY_ENGINE_STATEMENT  *St,
+  IN EFI_HII_VALUE                  *Value,
+  IN EFI_HII_HANDLE                 Handle
+  )
+{
+  DISPLAY_QUESTION_OPTION  *Opt;
+  EFI_IFR_NUMERIC          *Num;
+
+  switch (St->OpCode->OpCode) {
+    case EFI_IFR_ONE_OF_OP:
+      Opt = ValueToOption (St, Value);
+      if (Opt != NULL) {
+        return GetToken (Opt->OptionOpCode->Option, Handle);
+      }
+
+      return CatSPrint (NULL, L"%ld", HiiValueToUINT64 (Value));
+
+    case EFI_IFR_NUMERIC_OP:
+      Num = (EFI_IFR_NUMERIC *)St->OpCode;
+      if ((Num->Flags & EFI_IFR_DISPLAY_UINT_HEX) == EFI_IFR_DISPLAY_UINT_HEX) {
+        return CatSPrint (NULL, L"0x%lx", HiiValueToUINT64 (Value));
+      }
+
+      return CatSPrint (NULL, L"%ld", HiiValueToUINT64 (Value));
+
+    case EFI_IFR_CHECKBOX_OP:
+      return AllocateCopyPool (StrSize (Value->Value.b ? L"Enabled" : L"Disabled"), Value->Value.b ? L"Enabled" : L"Disabled");
+
+    default:
+      return NULL;
+  }
+}
+
+//
+// ---- change log --------------------------------------------------------------
+//
+#define THEME_MAX_CHANGES  64
+
+typedef struct {
+  EFI_HII_HANDLE     Handle;
+  EFI_QUESTION_ID    QuestionId;
+  CHAR16             *Prompt;
+  CHAR16             *Old;
+  CHAR16             *New;
+} THEME_CHANGE;
+
+STATIC THEME_CHANGE  mChanges[THEME_MAX_CHANGES];
+STATIC UINTN         mChangeCount;
+STATIC CHAR16        *mStatus;
+
+STATIC
+VOID
+FreeChange (
+  IN THEME_CHANGE  *C
+  )
+{
+  if (C->Prompt != NULL) {
+    FreePool (C->Prompt);
+  }
+
+  if (C->Old != NULL) {
+    FreePool (C->Old);
+  }
+
+  if (C->New != NULL) {
+    FreePool (C->New);
+  }
+
+  ZeroMem (C, sizeof (*C));
+}
+
+STATIC
+VOID
+UpdateStatusText (
+  VOID
+  )
+{
+  THEME_CHANGE  *Last;
+
+  if (mStatus != NULL) {
+    FreePool (mStatus);
+    mStatus = NULL;
+  }
+
+  gThemeStatusText = NULL;
+  if (mChangeCount == 0) {
+    return;
+  }
+
+  Last = &mChanges[mChangeCount - 1];
+  if (mChangeCount == 1) {
+    mStatus = CatSPrint (NULL, L"Changed: %s  %s \x2192 %s   (not saved yet - F10 saves)", Last->Prompt, Last->Old, Last->New);
+  } else {
+    mStatus = CatSPrint (
+                NULL,
+                L"Changed: %s  %s \x2192 %s   (+%d more, %d in total - F10 shows the list and saves)",
+                Last->Prompt,
+                Last->Old,
+                Last->New,
+                mChangeCount - 1,
+                mChangeCount
+                );
+  }
+
+  gThemeStatusText = mStatus;
+}
+
+UINTN
+ThemeChangeCount (
+  VOID
+  )
+{
+  return mChangeCount;
+}
+
+VOID
+ThemeClearChanges (
+  VOID
+  )
+{
+  UINTN  I;
+
+  for (I = 0; I < mChangeCount; I++) {
+    FreeChange (&mChanges[I]);
+  }
+
+  mChangeCount = 0;
+  UpdateStatusText ();
+}
+
+/**
+  The browser says nothing is modified any more (saved or discarded elsewhere):
+  forget the log.
+**/
+VOID
+ThemeSyncChanges (
+  IN FORM_DISPLAY_ENGINE_FORM  *FormData
+  )
+{
+  if ((mChangeCount != 0) && !FormData->SettingChangedFlag) {
+    ThemeClearChanges ();
+  }
+}
+
+VOID
+ThemeRecordChange (
+  IN FORM_DISPLAY_ENGINE_FORM  *FormData,
+  IN USER_INPUT                *UserInput
+  )
+{
+  FORM_DISPLAY_ENGINE_STATEMENT  *St;
+  EFI_IFR_QUESTION_HEADER        *Q;
+  CHAR16                         *Old;
+  CHAR16                         *New;
+  UINTN                          I;
+
+  St = UserInput->SelectedStatement;
+  if ((St == NULL) || (UserInput->InputValue.Type == 0) || (UserInput->InputValue.Type == EFI_IFR_TYPE_BUFFER)) {
+    return;
+  }
+
+  if ((St->OpCode->OpCode != EFI_IFR_ONE_OF_OP) &&
+      (St->OpCode->OpCode != EFI_IFR_NUMERIC_OP) &&
+      (St->OpCode->OpCode != EFI_IFR_CHECKBOX_OP))
+  {
+    return;
+  }
+
+  Q   = (EFI_IFR_QUESTION_HEADER *)((UINT8 *)St->OpCode + sizeof (EFI_IFR_OP_HEADER));
+  Old = ValueText (St, &St->CurrentValue, FormData->HiiHandle);
+  New = ValueText (St, &UserInput->InputValue, FormData->HiiHandle);
+  if ((Old == NULL) || (New == NULL)) {
+    goto Done;
+  }
+
+  for (I = 0; I < mChangeCount; I++) {
+    if ((mChanges[I].Handle == FormData->HiiHandle) && (mChanges[I].QuestionId == Q->QuestionId)) {
+      break;
+    }
+  }
+
+  if (I < mChangeCount) {
+    //
+    // Changed again: keep the original old value; drop it if back to where it was.
+    //
+    if (StrCmp (mChanges[I].Old, New) == 0) {
+      FreeChange (&mChanges[I]);
+      CopyMem (&mChanges[I], &mChanges[I + 1], (mChangeCount - I - 1) * sizeof (THEME_CHANGE));
+      mChangeCount--;
+      ZeroMem (&mChanges[mChangeCount], sizeof (THEME_CHANGE));
+    } else {
+      THEME_CHANGE  Tmp;
+
+      FreePool (mChanges[I].New);
+      mChanges[I].New = New;
+      New             = NULL;
+      //
+      // Move it to the end so the status bar shows it as the latest.
+      //
+      CopyMem (&Tmp, &mChanges[I], sizeof (Tmp));
+      CopyMem (&mChanges[I], &mChanges[I + 1], (mChangeCount - I - 1) * sizeof (THEME_CHANGE));
+      CopyMem (&mChanges[mChangeCount - 1], &Tmp, sizeof (Tmp));
+    }
+  } else if ((StrCmp (Old, New) != 0) && (mChangeCount < THEME_MAX_CHANGES)) {
+    mChanges[mChangeCount].Handle     = FormData->HiiHandle;
+    mChanges[mChangeCount].QuestionId = Q->QuestionId;
+    mChanges[mChangeCount].Prompt     = GetToken (Q->Header.Prompt, FormData->HiiHandle);
+    mChanges[mChangeCount].Old        = Old;
+    mChanges[mChangeCount].New        = New;
+    mChangeCount++;
+    Old = NULL;
+    New = NULL;
+  }
+
+  UpdateStatusText ();
+
+Done:
+  if (Old != NULL) {
+    FreePool (Old);
+  }
+
+  if (New != NULL) {
+    FreePool (New);
+  }
+}
+
+STATIC
+CONST THEME_CHANGE *
+FindChange (
+  IN EFI_HII_HANDLE   Handle,
+  IN EFI_QUESTION_ID  QuestionId
+  )
+{
+  UINTN  I;
+
+  for (I = 0; I < mChangeCount; I++) {
+    if ((mChanges[I].Handle == Handle) && (mChanges[I].QuestionId == QuestionId)) {
+      return &mChanges[I];
+    }
+  }
+
+  return NULL;
+}
+
+//
+// ---- help text ---------------------------------------------------------------
+//
+STATIC
+BOOLEAN
+IsWeakHelp (
+  IN CONST CHAR16  *Help,
+  IN CONST CHAR16  *Prompt
+  )
+{
+  CONST CHAR16  *P;
+
+  if ((Help == NULL) || (Help[0] == 0)) {
+    return TRUE;
+  }
+
+  for (P = Help; *P == L' ' || *P == 0xFFF0 || *P == 0xFFF1; P++) {
+  }
+
+  if (*P == 0) {
+    return TRUE;
+  }
+
+  return (BOOLEAN)((Prompt != NULL) && (CompareNoCase (P, Prompt) == 0));
+}
+
+STATIC
+VOID
+EFIAPI
+Append (
+  IN OUT CHAR16  **Str,
+  IN CONST CHAR16 *Fmt,
+  ...
+  )
+{
+  VA_LIST  Args;
+  CHAR16   *Part;
+  CHAR16   *Joined;
+
+  VA_START (Args, Fmt);
+  Part = CatVSPrint (NULL, Fmt, Args);
+  VA_END (Args);
+  if (Part == NULL) {
+    return;
+  }
+
+  if (*Str == NULL) {
+    *Str = Part;
+    return;
+  }
+
+  Joined = CatSPrint (NULL, L"%s%s", *Str, Part);
+  FreePool (*Str);
+  FreePool (Part);
+  *Str = Joined;
+}
+
+/**
+  Build the help panel text for the highlighted option. Takes ownership of
+  OriginalHelp (frees it) and returns a new pool string.
+**/
+CHAR16 *
+ThemeBuildHelp (
+  IN UI_MENU_OPTION  *MenuOption,
+  IN CHAR16          *OriginalHelp
+  )
+{
+  FORM_DISPLAY_ENGINE_STATEMENT  *St;
+  EFI_IFR_QUESTION_HEADER        *Q;
+  CONST CHAR16                   *Prompt;
+  CONST CHAR16                   *Desc;
+  CONST THEME_CHANGE             *Change;
+  CHAR16                         *Out;
+  CHAR16                         *Text;
+  LIST_ENTRY                     *Link;
+  DISPLAY_QUESTION_OPTION        *Opt;
+  EFI_IFR_NUMERIC                *Num;
+  UINT64                         Min, Max, Step;
+  UINT8                          Op;
+  BOOLEAN                        First;
+
+  if ((MenuOption == NULL) || (MenuOption->ThisTag == NULL)) {
+    return OriginalHelp;
+  }
+
+  St     = MenuOption->ThisTag;
+  Op     = St->OpCode->OpCode;
+  Prompt = MenuOption->Description;
+  Desc   = LookupDesc (Prompt);
+  Out    = NULL;
+
+  //
+  // 1. What it is.
+  //
+  if (!IsWeakHelp (OriginalHelp, Prompt)) {
+    Append (&Out, L"%s", OriginalHelp);
+    if (Desc != NULL) {
+      Append (&Out, L"\n\nIn plain words: %s", Desc);
+    }
+  } else if (Desc != NULL) {
+    Append (&Out, L"%s", Desc);
+  } else if (GenericDesc (Op) != NULL) {
+    Append (&Out, L"%s", GenericDesc (Op));
+  }
+
+  if (OriginalHelp != NULL) {
+    FreePool (OriginalHelp);
+  }
+
+  if (IsNoSave (Prompt)) {
+    Append (
+      &Out,
+#if THEME_HHC
+      L"\n\n!! On many AMI boards UMAF cannot save this one: it is kept in AMI's own setup, and a change made here comes back "
+      L"unchanged after F10. Change it in the firmware's own setup instead (the key shown at power-on, often F2 or Del)."
+#else
+      L"\n\n!! UMAF cannot save this one on this PC: it is kept in AMI's own setup, and a change made here comes back "
+      L"unchanged after F10. Change it in the original setup instead (the 'Firmware setup' entry in the boot menu)."
+#endif
+      );
+  }
+
+  if ((Op != EFI_IFR_ONE_OF_OP) && (Op != EFI_IFR_NUMERIC_OP) && (Op != EFI_IFR_CHECKBOX_OP)) {
+    return (Out != NULL) ? Out : AllocateZeroPool (sizeof (CHAR16));
+  }
+
+  //
+  // 2. Current value.
+  //
+  Text = ValueText (St, &St->CurrentValue, gFormData->HiiHandle);
+  if (Text != NULL) {
+    Append (&Out, L"\n\nNow set to: %s", Text);
+    FreePool (Text);
+  }
+
+  //
+  // 3. Choices / range.
+  //
+  if (Op == EFI_IFR_ONE_OF_OP) {
+    Append (&Out, L"\nChoices: ");
+    First = TRUE;
+    for (Link = GetFirstNode (&St->OptionListHead); !IsNull (&St->OptionListHead, Link); Link = GetNextNode (&St->OptionListHead, Link)) {
+      Opt  = DISPLAY_QUESTION_OPTION_FROM_LINK (Link);
+      Text = GetToken (Opt->OptionOpCode->Option, gFormData->HiiHandle);
+      if (Text == NULL) {
+        continue;
+      }
+
+      Append (
+        &Out,
+        L"%s%s%s",
+        First ? L"" : L", ",
+        Text,
+        ((Opt->OptionOpCode->Flags & (EFI_IFR_OPTION_DEFAULT | EFI_IFR_OPTION_DEFAULT_MFG)) != 0) ? L" (default)" : L""
+        );
+      First = FALSE;
+      FreePool (Text);
+    }
+  } else if (Op == EFI_IFR_NUMERIC_OP) {
+    Num = (EFI_IFR_NUMERIC *)St->OpCode;
+    switch (Num->Flags & EFI_IFR_NUMERIC_SIZE) {
+      case EFI_IFR_NUMERIC_SIZE_1:
+        Min  = Num->data.u8.MinValue;
+        Max  = Num->data.u8.MaxValue;
+        Step = Num->data.u8.Step;
+        break;
+      case EFI_IFR_NUMERIC_SIZE_2:
+        Min  = Num->data.u16.MinValue;
+        Max  = Num->data.u16.MaxValue;
+        Step = Num->data.u16.Step;
+        break;
+      case EFI_IFR_NUMERIC_SIZE_4:
+        Min  = Num->data.u32.MinValue;
+        Max  = Num->data.u32.MaxValue;
+        Step = Num->data.u32.Step;
+        break;
+      default:
+        Min  = Num->data.u64.MinValue;
+        Max  = Num->data.u64.MaxValue;
+        Step = Num->data.u64.Step;
+        break;
+    }
+
+    if (Max > Min) {
+      Append (&Out, L"\nAllowed: %ld to %ld", Min, Max);
+      if (Step > 1) {
+        Append (&Out, L", in steps of %ld", Step);
+      }
+    }
+  }
+
+  //
+  // 4. Changed this session?
+  //
+  Q      = (EFI_IFR_QUESTION_HEADER *)((UINT8 *)St->OpCode + sizeof (EFI_IFR_OP_HEADER));
+  Change = FindChange (gFormData->HiiHandle, Q->QuestionId);
+  if (Change != NULL) {
+    Append (&Out, L"\n\nChanged this session: %s \x2192 %s. Not saved yet - F10 saves, Esc offers to discard.", Change->Old, Change->New);
+  }
+
+  return Out;
+}
+
+//
+// Copy of S cut to Max characters ("..." at the end). Uses 3 rotating buffers,
+// enough for one CatSPrint call.
+//
+STATIC
+CONST CHAR16 *
+Shorten (
+  IN CONST CHAR16  *S,
+  IN UINTN         Max
+  )
+{
+  STATIC CHAR16  Buf[3][64];
+  STATIC UINTN   Next;
+  CHAR16         *B;
+  UINTN          Len;
+
+  if (S == NULL) {
+    return L"";
+  }
+
+  Len = StrLen (S);
+  if ((Len <= Max) || (Max < 4) || (Max >= 64)) {
+    return S;
+  }
+
+  B    = Buf[Next];
+  Next = (Next + 1) % 3;
+  CopyMem (B, S, (Max - 3) * sizeof (CHAR16));
+  B[Max - 3] = L'.';
+  B[Max - 2] = L'.';
+  B[Max - 1] = L'.';
+  B[Max]     = 0;
+  return B;
+}
+
+/**
+  Save/leave confirmation that lists what will be written.
+  Returns TRUE if a dialog was shown (Key has the answer).
+**/
+BOOLEAN
+ThemeConfirmWithChanges (
+  IN  CHAR16         *Question,
+  IN  CHAR16         *Options,
+  OUT EFI_INPUT_KEY  *Key
+  )
+{
+  CHAR16  *Line[14];
+  UINTN   N, I, Shown;
+
+  if (mChangeCount == 0) {
+    return FALSE;
+  }
+
+  ZeroMem (Line, sizeof (Line));
+  N         = 0;
+  Line[N++] = CatSPrint (NULL, L"%d setting(s) changed:", mChangeCount);
+  Line[N++] = CatSPrint (NULL, L"");
+  Shown     = mChangeCount > 8 ? 7 : mChangeCount;
+  for (I = 0; I < Shown; I++) {
+    Line[N++] = CatSPrint (
+                  NULL,
+                  L"%s:  %s \x2192 %s%s",
+                  Shorten (mChanges[I].Prompt, 44),
+                  Shorten (mChanges[I].Old, 20),
+                  Shorten (mChanges[I].New, 20),
+                  IsNoSave (mChanges[I].Prompt) ? L"  (NOT saved by UMAF - use Firmware setup)" : L""
+                  );
+  }
+
+  if (Shown < mChangeCount) {
+    Line[N++] = CatSPrint (NULL, L"... and %d more", mChangeCount - Shown);
+  }
+
+  Line[N++] = CatSPrint (NULL, L"");
+  Line[N++] = CatSPrint (NULL, L"%s", Question);
+  Line[N++] = CatSPrint (NULL, L"%s", Options);
+
+  CreateDialog (
+    Key,
+    Line[0], Line[1], Line[2], Line[3], Line[4], Line[5], Line[6],
+    Line[7], Line[8], Line[9], Line[10], Line[11], Line[12], Line[13],
+    NULL
+    );
+
+  for (I = 0; I < N; I++) {
+    if (Line[I] != NULL) {
+      FreePool (Line[I]);
+    }
+  }
+
+  return TRUE;
+}
