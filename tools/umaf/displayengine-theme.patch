+STATIC
+INTN
+CompareNoCase (
+  IN CONST CHAR16  *A,
+  IN CONST CHAR16  *B
+  )
+{
+  CHAR16  Ca, Cb;
+
+  while (*A == L' ') {
+    A++;
+  }
+
+  for ( ; ; A++, B++) {
+    Ca = *A;
+    Cb = *B;
+    if ((Ca >= L'a') && (Ca <= L'z')) {
+      Ca -= 32;
+    }
+
+    if ((Cb >= L'a') && (Cb <= L'z')) {
+      Cb -= 32;
+    }
+
+    //
+    // Trailing spaces in the prompt don't matter.
+    //
+    if ((Cb == 0) && (Ca == L' ')) {
+      while (*A == L' ') {
+        A++;
+      }
+
+      Ca = *A;
+    }
+
+    if ((Ca != Cb) || (Ca == 0)) {
+      return (INTN)Ca - (INTN)Cb;
+    }
+  }
+}
