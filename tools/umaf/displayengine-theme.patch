+/** @file
+  Mr. Machine: verbose help and change log for the setup browser.
+
+  - Every selectable option gets a plain-language explanation in the help panel.
+    Vendor help is kept; when it is missing or just repeats the option name, a
+    built-in description (AMD CBS / PBS / Overclocking / fan table) or a generic
+    one is used instead.
+  - Under it: the current value, the possible choices (default marked) or the
+    allowed range, and what was changed this session.
+  - Every change is logged; the status bar shows the latest one and the F10 /
+    leave dialogs list them all before anything is saved.
+**/
+
+#include "FormDisplay.h"
+#include "Theme.h"
+#include <Library/UefiLib.h>
+
+typedef struct {
+  CONST CHAR16    *Prompt;  // matched case-insensitively, whole name
+  CONST CHAR16    *Text;
+} THEME_DESC;
