diff --git i/MdeModulePkg/Universal/DisplayEngineDxe/ThemeConsole.c w/MdeModulePkg/Universal/DisplayEngineDxe/ThemeConsole.c
new file mode 100644
index 0000000..6729749
--- /dev/null
+++ w/MdeModulePkg/Universal/DisplayEngineDxe/ThemeConsole.c
@@ -0,0 +1,913 @@
+/** @file
+  Mr. Machine themed text console for the setup browser.
+
+  Replaces gST->ConOut while the form browser runs with a Simple Text Output
+  implementation that draws straight to GOP, so UMAF looks like the Limine boot
+  menu: Limine's builtin 8x16 font scaled 2x2 with 1 px spacing (17x32 cells),
+  the Limine term_palette, and a black text background that is transparent over
+  a wallpaper drawn here (radial gradient + hex grid + logo, as in gen.py).
+
+  If no GOP is found, nothing is replaced and the stock console is used.
+**/
+
+#include "FormDisplay.h"
+#include "Theme.h"
+#include <Protocol/GraphicsOutput.h>
+
+#include "ThemeFont.h"
+#if THEME_HHC
+#define THEME_LABEL  L"HANDHELD CONTROL \x00B7 ADVANCED BIOS"
+#include "ThemeLogoHhc.h"
+#else
+#define THEME_LABEL  L"MR. MACHINE \x00B7 ADVANCED"
+#include "ThemeLogo.h"
+#endif
+
+typedef struct {
+  CHAR16    Ch;
+  UINT8     Attr;
+} THEME_CELL;
+
+STATIC EFI_GRAPHICS_OUTPUT_PROTOCOL     *mGop;
+STATIC EFI_SIMPLE_TEXT_OUTPUT_PROTOCOL  mThemeOut;
+STATIC EFI_SIMPLE_TEXT_OUTPUT_MODE      mThemeMode;
+STATIC BOOLEAN                          mThemeActive;
+STATIC BOOLEAN                          mThemeFailed;
+STATIC UINT32                           *mWall;  // W*H background
+STATIC UINT32                           *mSpan;  // one text row of pixels
+STATIC THEME_CELL                       *mCells;
+STATIC UINT32                           mW, mH, mScale, mCellW, mCellH, mCols, mRows, mOffX, mOffY;
+STATIC BOOLEAN                          mPendingWrap;
+STATIC BOOLEAN                          mCursorDrawn;
+STATIC UINT32                           mCursorDrawnCol, mCursorDrawnRow;
+
+//
+// Limine term_palette / term_palette_bright mapped onto EFI colour numbers.
+// (EFI: black blue green cyan red magenta brown lightgray, then bright.)
+//
+STATIC CONST UINT32  mFg[16] = {
+  0x061019, 0x3b8fe0, 0x7fdcec, 0x7fdcec, 0xf7768e, 0xbb9af7, 0xe0af68, 0xd6f4ff,
+  0x6a819a, 0x6fb3ff, 0xa8ecf6, 0xa8ecf6, 0xff8fa3, 0xd2b8ff, 0xffd48a, 0xffffff
+};
+//
+// Backgrounds: black = wallpaper, cyan = Limine selection bar (solid),
+// everything else = tinted glass over the wallpaper.
+//
+STATIC CONST UINT32  mBg[8] = {
+  0x000000, 0x0e2235, 0x12343a, 0x7fdcec, 0x3a1420, 0x2a1f45, 0x3a2c14, 0x1b3347
+};
+
+#define CYAN  0x7fdcec
+#define BLUE  0x3b8fe0
+#define DIM   0x7f97ad
+
+STATIC
+UINT32
+Blend (
+  UINT32  Dst,
+  UINT32  Src,
+  UINT32  A      // 0..255 of Src
+  )
+{
+  UINT32  R, G, B;
+
+  R = (((Src >> 16) & 0xff) * A + ((Dst >> 16) & 0xff) * (255 - A)) / 255;
+  G = (((Src >> 8) & 0xff) * A + ((Dst >> 8) & 0xff) * (255 - A)) / 255;
+  B = ((Src & 0xff) * A + (Dst & 0xff) * (255 - A)) / 255;
+  return (R << 16) | (G << 8) | B;
+}
+
+STATIC
+UINT32
+ISqrt (
+  UINT64  V
+  )
+{
+  UINT64  X, Y;
+
+  if (V < 2) {
+    return (UINT32)V;
+  }
+
+  X = V;
+  Y = (X + 1) / 2;
+  while (Y < X) {
+    X = Y;
+    Y = (X + V / X) / 2;
+  }
+
+  return (UINT32)X;
+}
+
+STATIC
+VOID
+WallPlot (
+  INT32   X,
+  INT32   Y,
+  UINT32  Color,
+  UINT32  A
+  )
+{
+  if ((X < 0) || (Y < 0) || ((UINT32)X >= mW) || ((UINT32)Y >= mH) || (A == 0)) {
+    return;
+  }
+
+  mWall[(UINTN)Y * mW + X] = Blend (mWall[(UINTN)Y * mW + X], Color, A);
+}
+
+//
+// Hex-grid fade like gen.py's #hexfade: centre (50%,45%), .9 -> .25 at 70% -> 0.
+// Returns 0..255.
+//
+STATIC
+UINT32
+HexFade (
+  INT32  X,
+  INT32  Y
+  )
+{
+  INT64   Dx, Dy;
+  UINT32  T;       // distance / radius * 1000
+  UINT32  R;
+
+  R  = (mW > mH ? mW : mH) * 6 / 10;
+  Dx = X - (INT32)(mW / 2);
+  Dy = Y - (INT32)(mH * 45 / 100);
+  T  = ISqrt ((UINT64)(Dx * Dx + Dy * Dy)) * 1000 / R;
+  if (T >= 1000) {
+    return 0;
+  }
+
+  if (T <= 700) {
+    return 230 - (230 - 64) * T / 700;
+  }
+
+  return 64 - 64 * (T - 700) / 300;
+}
+
+STATIC
+VOID
+WallLine (
+  INT32   X0,
+  INT32   Y0,
+  INT32   X1,
+  INT32   Y1,
+  UINT32  Color,
+  UINT32  Alpha  // 0..255 before fade
+  )
+{
+  INT32  Dx, Dy, Sx, Sy, Err, E2;
+
+  Dx  = X1 > X0 ? X1 - X0 : X0 - X1;
+  Dy  = Y1 > Y0 ? Y0 - Y1 : Y1 - Y0;
+  Sx  = X0 < X1 ? 1 : -1;
+  Sy  = Y0 < Y1 ? 1 : -1;
+  Err = Dx + Dy;
+  for ( ; ;) {
+    WallPlot (X0, Y0, Color, Alpha * HexFade (X0, Y0) / 255);
+    if ((X0 == X1) && (Y0 == Y1)) {
+      break;
+    }
+
+    E2 = 2 * Err;
+    if (E2 >= Dy) {
+      Err += Dy;
+      X0  += Sx;
+    }
+
+    if (E2 <= Dx) {
+      Err += Dx;
+      Y0  += Sy;
+    }
+  }
+}
+
+//
+// Horizontal accent line that fades out at both ends (gen.py #line).
+//
+STATIC
+VOID
+WallAccentLine (
+  UINT32  Y,
+  UINT32  X0,
+  UINT32  X1,
+  UINT32  MaxA
+  )
+{
+  UINT32  X, Mid, Half, A;
+
+  if ((Y >= mH) || (X1 <= X0)) {
+    return;
+  }
+
+  Mid  = (X0 + X1) / 2;
+  Half = (X1 - X0) / 2;
+  for (X = X0; X < X1 && X < mW; X++) {
+    A = MaxA * (Half - (X > Mid ? X - Mid : Mid - X)) / Half;
+    WallPlot ((INT32)X, (INT32)Y, CYAN, A);
+  }
+}
+
+STATIC
+UINT8
+ToCp437 (
+  CHAR16  C
+  );
+
+//
+// Draw text into the wallpaper with the Limine font (for fixed decorations).
+//
+STATIC
+VOID
+WallText (
+  UINT32        X,
+  UINT32        Y,
+  CONST CHAR16  *S,
+  UINT32        Color,
+  UINT32        Scale
+  )
+{
+  UINT8   G;
+  UINT32  Gx, Gy, Sx, Sy;
+
+  for ( ; *S != 0; S++, X += 9 * Scale) {
+    G = ToCp437 (*S);
+    for (Gy = 0; Gy < 16; Gy++) {
+      for (Gx = 0; Gx < 8; Gx++) {
+        if ((mBuiltinFont[G * 16 + Gy] & (0x80 >> Gx)) != 0) {
+          for (Sy = 0; Sy < Scale; Sy++) {
+            for (Sx = 0; Sx < Scale; Sx++) {
+              WallPlot ((INT32)(X + Gx * Scale + Sx), (INT32)(Y + Gy * Scale + Sy), Color, 200);
+            }
+          }
+        }
+      }
+    }
+  }
+}
+
+STATIC
+VOID
+BuildWallpaper (
+  VOID
+  )
+{
+  UINT32  X, Y, T, R;
+  INT64   Dx, Dy;
+  INT32   Row, Col, Cx, Cy, I;
+  INT32   Hr, HexDx, HexDy;
+  INT32   Vx[7], Vy[7];
+  UINT32  C0, C1, Lx, Ly, A;
+  UINT8   *P;
+
+  //
+  // Gradient: #0c2236 at centre (50%,42%) -> #06111d at 55% -> #010409 at 75% radius.
+  //
+  R = ISqrt ((UINT64)mW * mW + (UINT64)mH * mH) * 75 / 200;
+  for (Y = 0; Y < mH; Y++) {
+    for (X = 0; X < mW; X++) {
+      Dx = (INT64)X - mW / 2;
+      Dy = (INT64)Y - mH * 42 / 100;
+      T  = ISqrt ((UINT64)(Dx * Dx + Dy * Dy)) * 255 / R;
+      if (T > 255) {
+        T = 255;
+      }
+
+      if (T < 140) {
+        C0 = 0x0c2236;
+        C1 = 0x06111d;
+        A  = T * 255 / 140;
+      } else {
+        C0 = 0x06111d;
+        C1 = 0x010409;
+        A  = (T - 140) * 255 / 115;
+      }
+
+      mWall[(UINTN)Y * mW + X] = Blend (C0, C1, A);
+    }
+  }
+
+  //
+  // Hex grid (pointy-top, r = 46 px at 1920 wide), cyan at ~7 % with radial fade.
+  //
+  Hr    = (INT32)(46 * mW / 1920);
+  if (Hr < 16) {
+    Hr = 16;
+  }
+
+  HexDx = Hr * 1732 / 1000;
+  HexDy = Hr * 3 / 2;
+  for (Row = -1; Row <= (INT32)(mH / HexDy) + 1; Row++) {
+    for (Col = -1; Col <= (INT32)(mW / HexDx) + 1; Col++) {
+      Cx = Col * HexDx + ((Row & 1) ? HexDx / 2 : 0);
+      Cy = Row * HexDy;
+      //
+      // Vertices at 30, 90, 150, 210, 270, 330 degrees (r - 2).
+      //
+      Vx[0] = Cx + (Hr - 2) * 866 / 1000;
+      Vy[0] = Cy + (Hr - 2) / 2;
+      Vx[1] = Cx;
+      Vy[1] = Cy + (Hr - 2);
+      Vx[2] = Cx - (Hr - 2) * 866 / 1000;
+      Vy[2] = Vy[0];
+      Vx[3] = Vx[2];
+      Vy[3] = Cy - (Hr - 2) / 2;
+      Vx[4] = Cx;
+      Vy[4] = Cy - (Hr - 2);
+      Vx[5] = Vx[0];
+      Vy[5] = Vy[3];
+      Vx[6] = Vx[0];
+      Vy[6] = Vy[0];
+      for (I = 0; I < 6; I++) {
+        WallLine (Vx[I], Vy[I], Vx[I + 1], Vy[I + 1], CYAN, 70);
+      }
+    }
+  }
+
+  //
+  // Header (3 text rows): logo + product line at the right end of the middle
+  // row, which is empty on every page and sits between the title frame lines;
+  // accent line under the header and above the 5-row footer.
+  //
+  {
+    UINT32  Hs, Ws, Sx, Sy;
+
+    Hs = 2 * mCellH - 8;                       // fits between the frame lines
+    Ws = THEME_LOGO_W * Hs / THEME_LOGO_H;
+    Ly = mOffY + mCellH + mCellH / 2 - Hs / 2;
+    Lx = mW - mOffX - 2 * mCellW - Ws;
+    for (Y = 0; Y < Hs; Y++) {
+      for (X = 0; X < Ws; X++) {
+        Sx = X * THEME_LOGO_W / Ws;
+        Sy = Y * THEME_LOGO_H / Hs;
+        P  = (UINT8 *)&mThemeLogo[(Sy * THEME_LOGO_W + Sx) * 4];
+        WallPlot ((INT32)(Lx + X), (INT32)(Ly + Y), ((UINT32)P[0] << 16) | ((UINT32)P[1] << 8) | P[2], P[3]);
+      }
+    }
+  }
+
+  WallText (
+    Lx - 14 - (INTN)StrLen (THEME_LABEL) * 9,
+    mOffY + mCellH + (mCellH - 16) / 2,
+    THEME_LABEL,
+    DIM,
+    1
+    );
+  WallAccentLine (mOffY + 3 * mCellH - 2, mW / 8, mW - mW / 8, 200);
+  if (mRows > 8) {
+    WallAccentLine (mOffY + (mRows - 5) * mCellH + 1, mW / 8, mW - mW / 8, 150);
+  }
+}
+
+typedef struct {
+  CHAR16    U;
+  UINT8     C;
+} CP_MAP;
+
+STATIC CONST CP_MAP  mCpMap[] = {
+  { 0x2500, 0xC4 }, { 0x2502, 0xB3 }, { 0x250C, 0xDA }, { 0x2510, 0xBF }, { 0x2514, 0xC0 }, { 0x2518, 0xD9 },
+  { 0x251C, 0xC3 }, { 0x2524, 0xB4 }, { 0x252C, 0xC2 }, { 0x2534, 0xC1 }, { 0x253C, 0xC5 }, { 0x2550, 0xCD },
+  { 0x2551, 0xBA }, { 0x2552, 0xD5 }, { 0x2553, 0xD6 }, { 0x2554, 0xC9 }, { 0x2555, 0xB8 }, { 0x2556, 0xB7 },
+  { 0x2557, 0xBB }, { 0x2558, 0xD4 }, { 0x2559, 0xD3 }, { 0x255A, 0xC8 }, { 0x255B, 0xBE }, { 0x255C, 0xBD },
+  { 0x255D, 0xBC }, { 0x255E, 0xC6 }, { 0x255F, 0xC7 }, { 0x2560, 0xCC }, { 0x2561, 0xB5 }, { 0x2562, 0xB6 },
+  { 0x2563, 0xB9 }, { 0x2564, 0xD1 }, { 0x2565, 0xD2 }, { 0x2566, 0xCB }, { 0x2567, 0xCF }, { 0x2568, 0xD0 },
+  { 0x2569, 0xCA }, { 0x256A, 0xD8 }, { 0x256B, 0xD7 }, { 0x256C, 0xCE }, { 0x2588, 0xDB }, { 0x2591, 0xB0 },
+  { 0x2592, 0xB1 }, { 0x2593, 0xB2 }, { 0x2580, 0xDF }, { 0x2584, 0xDC }, { 0x258C, 0xDD }, { 0x2590, 0xDE },
+  { 0x2191, 0x18 }, { 0x2193, 0x19 }, { 0x2192, 0x1A }, { 0x2190, 0x1B }, { 0x2195, 0x12 }, { 0x2194, 0x1D },
+  { 0x25B2, 0x1E }, { 0x25BA, 0x10 }, { 0x25B6, 0x10 }, { 0x25BC, 0x1F }, { 0x25C4, 0x11 }, { 0x25C0, 0x11 },
+  { 0x25A0, 0xFE }, { 0x25CF, 0x07 }, { 0x2022, 0x07 }, { 0x00B0, 0xF8 }, { 0x00B7, 0xFA }, { 0x00FA, 0xA3 },
+  { 0x00B1, 0xF1 }, { 0x00B5, 0xE6 }, { 0x00B2, 0xFD }, { 0x00E4, 0x84 }, { 0x00F6, 0x94 }, { 0x00FC, 0x81 },
+  { 0x00C4, 0x8E }, { 0x00D6, 0x99 }, { 0x00DC, 0x9A }, { 0x00E9, 0x82 }, { 0x00E1, 0xA0 }, { 0x00ED, 0xA1 },
+  { 0x00F3, 0xA2 }, { 0x00F1, 0xA4 }, { 0x00DF, 0xE1 }, { 0x00E7, 0x87 }, { 0x00E8, 0x8A }, { 0x00E0, 0x85 },
+  { 0x00EA, 0x88 }, { 0x2014, '-' }, { 0x2013, '-' }, { 0x2026, 0xFA }, { 0x2264, 0xF3 }, { 0x2265, 0xF2 },
+  { 0x2248, 0xF7 }, { 0x221E, 0xEC }, { 0x00A0, ' ' }
+};
+
+STATIC
+UINT8
+ToCp437 (
+  CHAR16  C
+  )
+{
+  UINTN  I;
+
+  if ((C >= 0x20) && (C < 0x7F)) {
+    return (UINT8)C;
+  }
+
+  for (I = 0; I < ARRAY_SIZE (mCpMap); I++) {
+    if (mCpMap[I].U == C) {
+      return mCpMap[I].C;
+    }
+  }
+
+  return '?';
+}
+
+//
+// Render cells [Col0, Col1) of Row into mSpan and blit them.
+//
+STATIC
+VOID
+DrawCells (
+  UINT32  Row,
+  UINT32  Col0,
+  UINT32  Col1
+  )
+{
+  UINT32      Col, Px, Py, Gx, Gy, Fg, BgIdx, Bg, Base, SpanW, Pix;
+  THEME_CELL  *Cell;
+  UINT8       G, Bits;
+  BOOLEAN     BoxChar;
+  UINTN       WallIdx;
+
+  if ((Row >= mRows) || (Col0 >= Col1)) {
+    return;
+  }
+
+  if (Col1 > mCols) {
+    Col1 = mCols;
+  }
+
+  SpanW = (Col1 - Col0) * mCellW;
+  for (Col = Col0; Col < Col1; Col++) {
+    Cell    = &mCells[Row * mCols + Col];
+    G       = ToCp437 (Cell->Ch);
+    Fg      = mFg[Cell->Attr & 0x0F];
+    BgIdx   = (Cell->Attr >> 4) & 0x07;
+    Bg      = mBg[BgIdx];
+    BoxChar = (BOOLEAN)(G >= 0xC0 && G <= 0xDF);  // VGA: extend column 8 into the gap
+    for (Py = 0; Py < mCellH; Py++) {
+      Gy      = Py / mScale;
+      Bits    = (Gy < 16) ? mBuiltinFont[G * 16 + Gy] : 0;
+      WallIdx = (UINTN)(mOffY + Row * mCellH + Py) * mW + mOffX + Col * mCellW;
+      for (Px = 0; Px < mCellW; Px++) {
+        Base = mWall[WallIdx + Px];
+        if (BgIdx == 0) {
+          Pix = Base;
+        } else if (BgIdx == EFI_CYAN) {
+          Pix = Bg;
+        } else {
+          Pix = Blend (Base, Bg, 225);
+        }
+
+        Gx = Px / mScale;
+        if (Gx < 8) {
+          if ((Bits & (0x80 >> Gx)) != 0) {
+            Pix = Fg;
+          }
+        } else if (BoxChar && ((Bits & 0x01) != 0)) {
+          Pix = Fg;
+        }
+
+        mSpan[Py * SpanW + (Col - Col0) * mCellW + Px] = Pix;
+      }
+    }
+  }
+
+  mGop->Blt (
+          mGop,
+          (EFI_GRAPHICS_OUTPUT_BLT_PIXEL *)mSpan,
+          EfiBltBufferToVideo,
+          0,
+          0,
+          mOffX + Col0 * mCellW,
+          mOffY + Row * mCellH,
+          SpanW,
+          mCellH,
+          SpanW * sizeof (UINT32)
+          );
+}
+
+STATIC
+VOID
+HideCursor (
+  VOID
+  )
+{
+  if (mCursorDrawn) {
+    mCursorDrawn = FALSE;
+    DrawCells (mCursorDrawnRow, mCursorDrawnCol, mCursorDrawnCol + 1);
+  }
+}
+
+STATIC
+VOID
+ShowCursor (
+  VOID
+  )
+{
+  UINT32  Col, Row, X, Y, Color;
+  UINT32  Line[64];
+
+  HideCursor ();
+  if (!mThemeMode.CursorVisible) {
+    return;
+  }
+
+  Col = (UINT32)mThemeMode.CursorColumn;
+  Row = (UINT32)mThemeMode.CursorRow;
+  if ((Col >= mCols) || (Row >= mRows) || (mCellW > 64)) {
+    return;
+  }
+
+  Color = mFg[mThemeMode.Attribute & 0x0F];
+  for (X = 0; X < mCellW; X++) {
+    Line[X] = Color;
+  }
+
+  for (Y = mCellH - 3; Y < mCellH - 1; Y++) {
+    mGop->Blt (mGop, (EFI_GRAPHICS_OUTPUT_BLT_PIXEL *)Line, EfiBltBufferToVideo, 0, 0, mOffX + Col * mCellW, mOffY + Row * mCellH + Y, mCellW, 1, 0);
+  }
+
+  mCursorDrawn    = TRUE;
+  mCursorDrawnCol = Col;
+  mCursorDrawnRow = Row;
+}
+
+STATIC
+VOID
+RedrawAll (
+  VOID
+  )
+{
+  UINT32  Row;
+
+  //
+  // Borders outside the text grid show the wallpaper.
+  //
+  mGop->Blt (mGop, (EFI_GRAPHICS_OUTPUT_BLT_PIXEL *)mWall, EfiBltBufferToVideo, 0, 0, 0, 0, mW, mOffY, 0);
+  mGop->Blt (mGop, (EFI_GRAPHICS_OUTPUT_BLT_PIXEL *)mWall, EfiBltBufferToVideo, 0, mOffY + mRows * mCellH, 0, mOffY + mRows * mCellH, mW, mH - mOffY - mRows * mCellH, 0);
+  mGop->Blt (mGop, (EFI_GRAPHICS_OUTPUT_BLT_PIXEL *)mWall, EfiBltBufferToVideo, 0, mOffY, 0, mOffY, mOffX, mRows * mCellH, 0);
+  mGop->Blt (mGop, (EFI_GRAPHICS_OUTPUT_BLT_PIXEL *)mWall, EfiBltBufferToVideo, mOffX + mCols * mCellW, mOffY, mOffX + mCols * mCellW, mOffY, mW - mOffX - mCols * mCellW, mRows * mCellH, 0);
+  for (Row = 0; Row < mRows; Row++) {
+    DrawCells (Row, 0, mCols);
+  }
+
+  mCursorDrawn = FALSE;
+}
+
+STATIC
+VOID
+ScrollUp (
+  VOID
+  )
+{
+  UINT32  I;
+
+  CopyMem (mCells, mCells + mCols, (mRows - 1) * mCols * sizeof (THEME_CELL));
+  for (I = 0; I < mCols; I++) {
+    mCells[(mRows - 1) * mCols + I].Ch   = L' ';
+    mCells[(mRows - 1) * mCols + I].Attr = (UINT8)mThemeMode.Attribute;
+  }
+
+  RedrawAll ();
+}
+
+//
+// ---- EFI_SIMPLE_TEXT_OUTPUT_PROTOCOL ----------------------------------------
+//
+STATIC
+EFI_STATUS
+EFIAPI
+ThemeClearScreen (
+  IN EFI_SIMPLE_TEXT_OUTPUT_PROTOCOL  *This
+  )
+{
+  UINT32  I;
+
+  for (I = 0; I < mCols * mRows; I++) {
+    mCells[I].Ch   = L' ';
+    mCells[I].Attr = (UINT8)mThemeMode.Attribute;
+  }
+
+  mThemeMode.CursorColumn = 0;
+  mThemeMode.CursorRow    = 0;
+  mPendingWrap            = FALSE;
+  RedrawAll ();
+  ShowCursor ();
+  return EFI_SUCCESS;
+}
+
+STATIC
+EFI_STATUS
+EFIAPI
+ThemeReset (
+  IN EFI_SIMPLE_TEXT_OUTPUT_PROTOCOL  *This,
+  IN BOOLEAN                          ExtendedVerification
+  )
+{
+  mThemeMode.Attribute = EFI_TEXT_ATTR (EFI_LIGHTGRAY, EFI_BLACK);
+  return ThemeClearScreen (This);
+}
+
+STATIC
+EFI_STATUS
+EFIAPI
+ThemeOutputString (
+  IN EFI_SIMPLE_TEXT_OUTPUT_PROTOCOL  *This,
+  IN CHAR16                           *String
+  )
+{
+  UINT32  Row, Col, RunStart;
+  CHAR16  C;
+
+  HideCursor ();
+  Row      = (UINT32)mThemeMode.CursorRow;
+  Col      = (UINT32)mThemeMode.CursorColumn;
+  RunStart = Col;
+
+  for ( ; *String != 0; String++) {
+    C = *String;
+    if ((C == 0xFFF0) || (C == 0xFFF1)) {
+      // NARROW_CHAR / WIDE_CHAR markers.
+      continue;
+    }
+
+    if ((C == CHAR_CARRIAGE_RETURN) || (C == CHAR_LINEFEED) || (C == CHAR_BACKSPACE)) {
+      DrawCells (Row, RunStart, Col);
+      if (C == CHAR_CARRIAGE_RETURN) {
+        Col = 0;
+      } else if (C == CHAR_BACKSPACE) {
+        if (Col > 0) {
+          Col--;
+        }
+      } else {
+        if (Row + 1 >= mRows) {
+          ScrollUp ();
+        } else {
+          Row++;
+        }
+      }
+
+      mPendingWrap = FALSE;
+      RunStart     = Col;
+      continue;
+    }
+
+    if (mPendingWrap) {
+      DrawCells (Row, RunStart, mCols);
+      mPendingWrap = FALSE;
+      Col          = 0;
+      if (Row + 1 >= mRows) {
+        ScrollUp ();
+      } else {
+        Row++;
+      }
+
+      RunStart = 0;
+    }
+
+    mCells[Row * mCols + Col].Ch   = C;
+    mCells[Row * mCols + Col].Attr = (UINT8)(mThemeMode.Attribute & 0x7F);
+    if (Col + 1 >= mCols) {
+      mPendingWrap = TRUE;   // wrap only when the next character comes
+      Col          = mCols;
+    } else {
+      Col++;
+    }
+  }
+
+  DrawCells (Row, RunStart, Col);
+  mThemeMode.CursorRow    = (INT32)Row;
+  mThemeMode.CursorColumn = (INT32)(Col >= mCols ? mCols - 1 : Col);
+  ShowCursor ();
+  return EFI_SUCCESS;
+}
+
+STATIC
+EFI_STATUS
+EFIAPI
+ThemeTestString (
+  IN EFI_SIMPLE_TEXT_OUTPUT_PROTOCOL  *This,
+  IN CHAR16                           *String
+  )
+{
+  return EFI_SUCCESS;
+}
+
+STATIC
+EFI_STATUS
+EFIAPI
+ThemeQueryMode (
+  IN EFI_SIMPLE_TEXT_OUTPUT_PROTOCOL  *This,
+  IN UINTN                            ModeNumber,
+  OUT UINTN                           *Columns,
+  OUT UINTN                           *Rows
+  )
+{
+  if (ModeNumber != 0) {
+    return EFI_UNSUPPORTED;
+  }
+
+  *Columns = mCols;
+  *Rows    = mRows;
+  return EFI_SUCCESS;
+}
+
+STATIC
+EFI_STATUS
+EFIAPI
+ThemeSetMode (
+  IN EFI_SIMPLE_TEXT_OUTPUT_PROTOCOL  *This,
+  IN UINTN                            ModeNumber
+  )
+{
+  if (ModeNumber != 0) {
+    return EFI_UNSUPPORTED;
+  }
+
+  return ThemeClearScreen (This);
+}
+
+STATIC
+EFI_STATUS
+EFIAPI
+ThemeSetAttribute (
+  IN EFI_SIMPLE_TEXT_OUTPUT_PROTOCOL  *This,
+  IN UINTN                            Attribute
+  )
+{
+  mThemeMode.Attribute = (INT32)(Attribute & 0x7F);
+  return EFI_SUCCESS;
+}
+
+STATIC
+EFI_STATUS
+EFIAPI
+ThemeSetCursorPosition (
+  IN EFI_SIMPLE_TEXT_OUTPUT_PROTOCOL  *This,
+  IN UINTN                            Column,
+  IN UINTN                            Row
+  )
+{
+  if ((Column >= mCols) || (Row >= mRows)) {
+    return EFI_UNSUPPORTED;
+  }
+
+  HideCursor ();
+  mThemeMode.CursorColumn = (INT32)Column;
+  mThemeMode.CursorRow    = (INT32)Row;
+  mPendingWrap            = FALSE;
+  ShowCursor ();
+  return EFI_SUCCESS;
+}
+
+STATIC
+EFI_STATUS
+EFIAPI
+ThemeEnableCursor (
+  IN EFI_SIMPLE_TEXT_OUTPUT_PROTOCOL  *This,
+  IN BOOLEAN                          Visible
+  )
+{
+  mThemeMode.CursorVisible = Visible;
+  if (Visible) {
+    ShowCursor ();
+  } else {
+    HideCursor ();
+  }
+
+  return EFI_SUCCESS;
+}
+
+//
+// Pick the GOP mode: keep the current one if it is at least 1600 wide,
+// otherwise switch to 1920x1080 (or the largest mode up to 1920x1200).
+//
+STATIC
+VOID
+ChooseMode (
+  VOID
+  )
+{
+  UINT32                                Mode, Best, BestArea, Area;
+  UINTN                                 Size;
+  EFI_GRAPHICS_OUTPUT_MODE_INFORMATION  *Info;
+
+  if (mGop->Mode->Info->HorizontalResolution >= 1600) {
+    return;
+  }
+
+  Best     = mGop->Mode->Mode;
+  BestArea = mGop->Mode->Info->HorizontalResolution * mGop->Mode->Info->VerticalResolution;
+  for (Mode = 0; Mode < mGop->Mode->MaxMode; Mode++) {
+    if (EFI_ERROR (mGop->QueryMode (mGop, Mode, &Size, &Info))) {
+      continue;
+    }
+
+    if ((Info->HorizontalResolution == 1920) && (Info->VerticalResolution == 1080)) {
+      Best = Mode;
+      FreePool (Info);
+      break;
+    }
+
+    Area = Info->HorizontalResolution * Info->VerticalResolution;
+    if ((Info->HorizontalResolution <= 1920) && (Info->VerticalResolution <= 1200) && (Area > BestArea)) {
+      Best     = Mode;
+      BestArea = Area;
+    }
+
+    FreePool (Info);
+  }
+
+  if (Best != mGop->Mode->Mode) {
+    mGop->SetMode (mGop, Best);
+  }
+}
+
+STATIC
+BOOLEAN
+ThemeSetup (
+  VOID
+  )
+{
+  EFI_STATUS  Status;
+
+  Status = gBS->HandleProtocol (gST->ConsoleOutHandle, &gEfiGraphicsOutputProtocolGuid, (VOID **)&mGop);
+  if (EFI_ERROR (Status)) {
+    Status = gBS->LocateProtocol (&gEfiGraphicsOutputProtocolGuid, NULL, (VOID **)&mGop);
+  }
+
+  if (EFI_ERROR (Status) || (mGop == NULL)) {
+    return FALSE;
+  }
+
+  ChooseMode ();
+  mW = mGop->Mode->Info->HorizontalResolution;
+  mH = mGop->Mode->Info->VerticalResolution;
+
+  //
+  // Limine look: 2x2 font + 1 px spacing. Fall back to 1x on small screens so
+  // the browser still gets at least 100 columns.
+  //
+  mScale = (mW / 17 >= 100 && mH / 32 >= 25) ? 2 : 1;
+  mCellW = 8 * mScale + 1;
+  mCellH = 16 * mScale;
+  mCols  = mW / mCellW;
+  mRows  = mH / mCellH;
+  mOffX  = (mW - mCols * mCellW) / 2;
+  mOffY  = (mH - mRows * mCellH) / 2;
+  if ((mCols < 80) || (mRows < 25)) {
+    return FALSE;
+  }
+
+  mWall  = AllocatePool ((UINTN)mW * mH * sizeof (UINT32));
+  mSpan  = AllocatePool ((UINTN)mCols * mCellW * mCellH * sizeof (UINT32));
+  mCells = AllocateZeroPool ((UINTN)mCols * mRows * sizeof (THEME_CELL));
+  if ((mWall == NULL) || (mSpan == NULL) || (mCells == NULL)) {
+    return FALSE;
+  }
+
+  BuildWallpaper ();
+
+  mThemeMode.MaxMode       = 1;
+  mThemeMode.Mode          = 0;
+  mThemeMode.Attribute     = EFI_TEXT_ATTR (EFI_LIGHTGRAY, EFI_BLACK);
+  mThemeMode.CursorColumn  = 0;
+  mThemeMode.CursorRow     = 0;
+  mThemeMode.CursorVisible = FALSE;
+
+  mThemeOut.Reset             = ThemeReset;
+  mThemeOut.OutputString      = ThemeOutputString;
+  mThemeOut.TestString        = ThemeTestString;
+  mThemeOut.QueryMode         = ThemeQueryMode;
+  mThemeOut.SetMode           = ThemeSetMode;
+  mThemeOut.SetAttribute      = ThemeSetAttribute;
+  mThemeOut.ClearScreen       = ThemeClearScreen;
+  mThemeOut.SetCursorPosition = ThemeSetCursorPosition;
+  mThemeOut.EnableCursor      = ThemeEnableCursor;
+  mThemeOut.Mode              = &mThemeMode;
+  return TRUE;
+}
+
+/**
+  Make sure the themed console is gST->ConOut. Called at every entry from the
+  browser (cheap after the first time), so a console reconnect by UiApp cannot
+  silently put the stock console back.
+**/
+VOID
+ThemeConsoleActivate (
+  VOID
+  )
+{
+  if (mThemeFailed) {
+    return;
+  }
+
+  if (!mThemeActive) {
+    if (!ThemeSetup ()) {
+      mThemeFailed = TRUE;
+      return;
+    }
+
+    mThemeActive = TRUE;
+    ThemeClearScreen (&mThemeOut);
+  }
+
+  if (gST->ConOut != &mThemeOut) {
+    gST->ConOut   = &mThemeOut;
+    gST->Hdr.CRC32 = 0;
+    gBS->CalculateCrc32 ((UINT8 *)&gST->Hdr, gST->Hdr.HeaderSize, &gST->Hdr.CRC32);
+  }
+}
