-  @param  Value                  Value of the set operation.
-
-**/
-VOID
-LibSetUnicodeMem (
-  IN VOID    *Buffer,
-  IN UINTN   Size,
-  IN CHAR16  Value
-  )
-{
-  CHAR16  *Ptr;
-
-  Ptr = Buffer;
-  while ((Size--)  != 0) {
-    *(Ptr++) = Value;
-  }
-}
