#!/usr/bin/env bash
# Handheld Control on this PC. No terminal and no password: the backend is a
# root system service (installed once with: sudo desktop/install.sh) that
# systemd starts when this window connects and that stops when it closes,
# putting everything the plugin changed back.
#   hhc-desktop --user   run from this repository as you, read-only (for development)
set -euo pipefail
DIR=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
PORT=${HHC_PORT:-8765}
URL="http://127.0.0.1:$PORT"
TOKEN_FILE=/run/hhc-desktop/token
# A Chromium-based browser for the --app window, with its own profile so it
# runs as its own process (the script waits for the window to close). Flatpak
# browsers (Bazzite) keep the profile in their own data folder.
FLAGS=(--class=hhc-desktop --window-size=420,900)
APP=()
for b in chromium chromium-browser google-chrome-stable google-chrome brave-browser brave; do
    command -v "$b" >/dev/null && { APP=("$b" --user-data-dir="$HOME/.cache/hhc-desktop/chromium" "${FLAGS[@]}"); break; }
done
if [ ${#APP[@]} = 0 ] && command -v flatpak >/dev/null; then
    for id in org.chromium.Chromium com.google.Chrome com.brave.Browser io.github.ungoogled_software.ungoogled_chromium; do
        flatpak info "$id" >/dev/null 2>&1 && {
            APP=(flatpak run "$id" --user-data-dir="$HOME/.var/app/$id/hhc-desktop" "${FLAGS[@]}"); break; }
    done
fi
say() { notify-send -a "Handheld Control" "Handheld Control" "$1" 2>/dev/null || echo "$1" >&2; }

if [ "${1:-}" = "--user" ]; then
    if [ ! -f "$DIR/dist/bundle.js" ] || [ -n "$(find "$DIR/../src" "$DIR/shims" "$DIR/entry.tsx" "$DIR/index.html" -newer "$DIR/dist/bundle.js" 2>/dev/null)" ]; then
        (cd "$DIR/.." && npm install --no-audit --no-fund >/dev/null && npx rollup -c desktop/rollup.config.mjs)
    fi
    PORT=${HHC_PORT:-8766}
    URL="http://127.0.0.1:$PORT"
    TOKEN=$(head -c 16 /dev/urandom | od -An -tx1 | tr -d ' \n')
    printf '%s\n' "$TOKEN" | python3 "$DIR/server.py" --port "$PORT" --token - &
    SERVER=$!
    for _ in $(seq 80); do curl -s -m 1 "$URL/ping" >/dev/null && break; sleep 0.25; done
else
    if ! systemctl is-enabled --quiet hhc-desktop.socket 2>/dev/null; then
        say "Not set up yet: install it with  curl -fsSL https://raw.githubusercontent.com/kupecjan1980-pixel/handheld-control/master/desktop/get.sh | sudo bash"
        exit 1
    fi
    # The first connection starts the service; it writes the token before answering.
    curl -s -m 30 "$URL/ping" >/dev/null || { say "The backend didn't start: journalctl -u hhc-desktop"; exit 1; }
    for _ in $(seq 40); do [ -r "$TOKEN_FILE" ] && break; sleep 0.25; done
    TOKEN=$(cat "$TOKEN_FILE")
fi

if [ ${#APP[@]} = 0 ]; then
    say "No Chromium-based browser found. Install one, e.g.  flatpak install flathub org.chromium.Chromium"
    [ -n "${SERVER:-}" ] && kill "$SERVER" 2>/dev/null
    exit 1
fi
"${APP[@]}" --app="$URL/?token=$TOKEN" >/dev/null 2>&1 || true
curl -s -m 10 -X POST -H "X-HHC-Token: $TOKEN" "$URL/quit" >/dev/null || true
[ -n "${SERVER:-}" ] && wait "$SERVER" || true
